# Copy to .env and fill in. Never commit .env. Names only; no real values here.

# --- Used from Stage 00 ---
# One of: HI-Small, LI-Small, HI-Medium, LI-Medium  (default: HI-Small)
RS_DATASET_VARIANT=HI-Small
# Root folder for raw/processed/snapshots data (default: <repo>/data)
RS_DATA_DIR=
# Global random seed (default: 42)
RS_SEED=42
# Share of rows (by time) used for train and validation; the rest is test (defaults 0.6, 0.2)
RS_TRAIN_FRAC=0.6
RS_VAL_FRAC=0.2

# --- Stage 02: graph and features (all optional) ---
# Hub cap: accounts with more distinct counterparties than this are dropped from the graph.
# Leave blank to use the value tuned on validation (hub_cap_tuning.json).
RS_HUB_CAP=
# Cap for the derived device / IP / VPA-handle attributes (default 50)
RS_ATTR_CAP=50
# Communities larger than this are split with Louvain (default 200)
RS_COMMUNITY_CAP=200
# Louvain resolution (default 1.0)
RS_LOUVAIN_RESOLUTION=1.0

# --- Stage 03: detectors and evaluation (all optional) ---
# Share of negative training rows kept when fitting (all positives are kept). Default 0.2
RS_NEG_SAMPLE_FRAC=0.2
# Cost model, rupees. Planning assumptions, not measurements (docs/EVALUATION.md)
RS_REVIEW_COST_INR=250
RS_FP_COST_INR=500
# Share of a caught ring's illicit volume a review could stop (1.0 = the plan's definition)
RS_LOSS_CAPTURE_RATE=1.0
# A predicted ring is a true positive at Jaccard >= this value (default 0.5)
RS_RING_TAU=0.5
# Predicted rings with fewer accounts than this are dropped (default 3)
RS_RING_MIN_SIZE=3

# --- Stage 04: snapshots and API (all optional except the token for analyst actions) ---
# Git commit recorded in the snapshot bundle (or pass --git-commit to the exporter)
RS_GIT_COMMIT=
# Folder holding the snapshot bundle (default: <data dir>/snapshots)
RS_SNAPSHOT_DIR=
# Shared analyst token, at least 16 characters. Without it the API is read-only
# (actions and the audit list answer 503). Never commit the real value.
RS_ANALYST_TOKEN=
# Audit database. Only SQLite for now: sqlite:///path/to/file.sqlite3
# (default: <data dir>/audit/audit.sqlite3). Postgres arrives with deployment (Stage 09).
RS_AUDIT_DB_URL=
# Allowed browser origins, comma separated, no wildcard (default http://localhost:3000)
RS_CORS_ORIGINS=http://localhost:3000
# Requests per minute per client address; 0 turns a limit off (defaults 120 and 20)
RS_RATE_LIMIT_READ_PER_MIN=120
RS_RATE_LIMIT_WRITE_PER_MIN=20

# --- Later stages (listed so the names are reserved; unused until noted) ---
# Stage 01: Kaggle credentials. Preferred: %USERPROFILE%\.kaggle\kaggle.json. Env alternative:
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# Stage 06: LLM providers (Groq for dev, Gemini for prod)
# RS_LLM_PROVIDER=
# GROQ_API_KEY=
# GEMINI_API_KEY=
