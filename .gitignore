# Secrets
.env
*.pem
kaggle.json
.kaggle/

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / frontend
node_modules/
frontend/.next/
frontend/out/

# Data: raw and processed stay local. MANIFEST.json is committed; frozen evaluation snapshots stay local pending redistribution review.
data/raw/*
!data/raw/.gitkeep
!data/raw/MANIFEST.json
data/processed/*
!data/processed/.gitkeep

# Trained models and caches
/models/
*.joblib

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/


# RingSentinel audit database (sensitive analyst data)
data/audit/

# Frozen evaluation snapshots: retain locally, exclude from public release.
data/snapshots/*
!data/snapshots/.gitkeep
frontend/public/snapshots/*
!frontend/public/snapshots/.gitkeep