{
  "name": "ringsentinel-frontend",
  "version": "0.6.0",
  "private": true,
  "description": "RingSentinel analyst UI (Stage 05). Static export; works from snapshots with the backend off.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
