# Copy to .env.local. Names only; nothing here is secret (NEXT_PUBLIC_* values end up in the
# browser bundle, so never put a token here).
# Base URL of the backend API, e.g. http://127.0.0.1:8000 . Blank = snapshot-only mode: the UI
# reads the JSON files in public/snapshots and never calls an API.
NEXT_PUBLIC_API_BASE_URL=
# How long to wait for the API before falling back to the snapshot (default 4000 ms).
NEXT_PUBLIC_API_TIMEOUT_MS=4000
